{
  "manifest_version": 3,
  "name": "Browser Extension",
  "version": "1.0.0",
  "description": "Cross-browser extension built with Manifest V3.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
